{
  "name": "@know-it-owl/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/gql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/client-preset": "^4.8.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "graphql": "^16.14.2",
    "vite": "^5.4.11"
  },
  "exports": {
    "./services/*": "./src/services/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./gql": "./src/gql/index.ts",
    "./gql/graphql": "./src/gql/graphql.ts"
  }
}
